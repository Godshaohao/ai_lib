#!/bin/csh -f
# ==============================================================================
# AI LIB QoR · <TOOL_NAME> 检查脚本模板（自动生成自有效版本，供手动/LSF 执行）
# ==============================================================================
# Vendor         : {{ vendor }}
# Library        : {{ library }}
{% if business_ip -%}
# Business IP    : {{ business_ip }} ({{ ip_type or 'N/A' }})
{% endif -%}
# Effective Rev  : {{ revision }}
# Generated At   : {{ generated_at }}
# Template       : {{ template }} ({{ template_source }})
# Deliveries Used: {{ deliveries_used | join(', ') if deliveries_used else 'N/A' }}
# Members Summary: LEF={{ counts.LEF }} | DB={{ counts.DB }} | LIB={{ counts.LIBERTY }} | GDS={{ counts.GDS }} | CDL={{ counts.CDL }}
# ==============================================================================

# ---------- [TODO: 按公司 EDA 环境修改] ----------
setenv TOOL_BIN "<tool_cmd>"
setenv RUN_DIR  "{{ output_dir }}"
# -------------------------------------------------

mkdir -p "$RUN_DIR"
set LOG_FILE = "$RUN_DIR/<tool>_check.log"
set TCL_FILE = "$RUN_DIR/run_<tool>.tcl"

cat << 'EOF_TOOL_TCL' > "$TCL_FILE"
set run_dir "{{ output_dir }}"
set lef_files [list \
{% for item in lef_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]
set db_files [list \
{% for item in db_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]
set lib_files [list \
{% for item in lib_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]

# TODO: 在此处粘贴/适配公司标准 Tcl 检查命令（若含连续花括号请使用 Jinja2 raw 块）
puts "Loaded LEF=[llength $lef_files] DB=[llength $db_files] LIB=[llength $lib_files]"
exit 0
EOF_TOOL_TCL

$TOOL_BIN -f "$TCL_FILE" |& tee "$LOG_FILE"
exit $status
