#!/bin/csh -f
# ==============================================================================
# AI LIB QoR · Innovus LEF + DB 物理库检查脚本（自动生成自有效版本，供手动/LSF 执行）
# ==============================================================================
# Vendor         : {{ vendor }}
# Library        : {{ library }}
{% if business_ip -%}
# Business IP    : {{ business_ip }} ({{ ip_type or 'N/A' }})
{% endif -%}
# Effective Rev  : {{ revision }}
# Generated At   : {{ generated_at }}
# Template       : {{ template }} ({{ template_source }})
# Deliveries Used: {{ deliveries_used | join(', ') if deliveries_used else 'N/A' }}
# Members Summary: LEF={{ counts.LEF }} | DB={{ counts.DB }} | LIB={{ counts.LIBERTY }}
# ==============================================================================

# ---------- [TODO: 按公司 EDA 环境修改以下变量] ----------
setenv INNOVUS_BIN "innovus"
setenv RUN_DIR     "{{ output_dir }}"
# 请指定工艺 Tech LEF（必须在 Macro LEF 之前加载；若本库已包含 Tech LEF 可留空）
setenv TECH_LEF    ""
setenv MAX_CPU     "4"
# ---------------------------------------------------------

mkdir -p "$RUN_DIR"
set LOG_FILE     = "$RUN_DIR/innovus_check.log"
set SUMMARY_FILE = "$RUN_DIR/innovus_summary.txt"
set TCL_FILE     = "$RUN_DIR/run_innovus.tcl"

{% if not lef_files %}
echo "[WARN] 当前有效版本 {{ revision }} 未包含 .lef 文件。"
{% endif %}

cat << 'EOF_INNOVUS_TCL' > "$TCL_FILE"
# Auto-generated Innovus physical + timing library audit script
# Scope: {{ vendor }}/{{ library }}{% if business_ip %}::{{ business_ip }}{% endif %} ({{ revision }})

set run_dir  "{{ output_dir }}"
set tech_lef "$::env(TECH_LEF)"

set macro_lefs [list \
{% for item in lef_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]

set db_files [list \
{% for item in db_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]

set lib_files [list \
{% for item in lib_files %}
    "{{ item.absolute_path }}" \
{% endfor %}
]

puts "=== \[AI_LIB_QOR\] Innovus Check Start: {{ vendor }}/{{ library }}{% if business_ip %}::{{ business_ip }}{% endif %} {{ revision }} ==="
puts "TECH_LEF   : $tech_lef"
puts "MACRO LEFs : [llength $macro_lefs]"
puts "DB files   : [llength $db_files]"
puts "LIB files  : [llength $lib_files]"

if {[llength $macro_lefs] == 0} {
    puts "ERROR: No .lef files found in effective revision {{ revision }}."
    exit 2
}

set all_lefs [list]
if {$tech_lef ne ""} {
    lappend all_lefs $tech_lef
}
foreach f $macro_lefs {
    lappend all_lefs $f
}

# ---------- [TODO: 按 Innovus 版本（Legacy vs Stylus/Common UI）调整以下命令] ----------
# 以下默认使用 Common UI / Stylus 风格占位；若使用 Legacy UI 可替换为 init_lef_file + init_design
if {[catch {set_multi_cpu_usage -local_cpu $::env(MAX_CPU)} err]} {
    puts "INFO: set_multi_cpu_usage skipped ($err)"
}

# 1. 读取物理 LEF（Tech LEF + Macro LEF）
if {[catch {read_physical -lefs $all_lefs} err]} {
    puts "ERROR: read_physical -lefs failed: $err"
    exit 1
}

# 2. 若需要结合 .lib 做 Timing/Physical 交叉核验，可取消注释并指定目标 Corner：
# if {[llength $lib_files] > 0} {
#     read_libs [lindex $lib_files 0]
# }

# 3. 导出 Macro / Site / Pin 基础体检报告
set rpt_fp [open "$run_dir/innovus_lef_audit.rpt" "w"]
puts $rpt_fp "# Innovus LEF Audit Report ({{ vendor }}/{{ library }}{% if business_ip %}::{{ business_ip }}{% endif %} {{ revision }})"
if {[llength [info commands get_db]] > 0} {
    set cells [get_db base_cells]
    puts $rpt_fp "Total base_cells loaded: [llength $cells]"
    foreach c $cells {
        set cname [get_db $c .name]
        set csite [get_db $c .site.name]
        set cbbox [get_db $c .bbox]
        set cpins [llength [get_db $c .base_pins]]
        puts $rpt_fp "CELL $cname | SITE=$csite | BBOX=$cbbox | PINS=$cpins"
    }
} else {
    puts $rpt_fp "INFO: Common UI get_db unavailable; please insert Legacy dbGet commands here."
}
close $rpt_fp

# 4. [TODO] 在此补充公司标准检查（如 check_lef / check_design / verify_drc / pin grid 核验）：
# check_design -type all -out_file "$run_dir/check_design.rpt"

puts "=== \[AI_LIB_QOR\] Innovus Check Finished ==="
exit 0
EOF_INNOVUS_TCL

echo "[INFO] Running Innovus check in $RUN_DIR ..."
echo "[INFO] Command: $INNOVUS_BIN -stylus -batch -no_gui -files $TCL_FILE -log $LOG_FILE"
$INNOVUS_BIN -stylus -batch -no_gui -files "$TCL_FILE" -log "$LOG_FILE"
set INV_STATUS = $status

echo "=== Innovus Check Summary ({{ vendor }}/{{ library }}{% if business_ip %}::{{ business_ip }}{% endif %} {{ revision }}) ===" > "$SUMMARY_FILE"
echo "Exit Status : $INV_STATUS" >> "$SUMMARY_FILE"
echo "Log File    : $LOG_FILE" >> "$SUMMARY_FILE"
if (-f "$LOG_FILE") then
    echo "Error Count : `grep -ci 'error' $LOG_FILE`" >> "$SUMMARY_FILE"
    echo "Warn Count  : `grep -ci 'warning' $LOG_FILE`" >> "$SUMMARY_FILE"
endif
cat "$SUMMARY_FILE"

exit $INV_STATUS
