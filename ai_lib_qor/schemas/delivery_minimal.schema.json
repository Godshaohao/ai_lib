{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["vendor", "library", "version", "version_date", "root", "views"],
  "oneOf": [
    {"required": ["directory_mtime"], "not": {"required": ["directory_created_at"]}},
    {"required": ["directory_created_at"], "not": {"required": ["directory_mtime"]}}
  ],
  "properties": {
    "vendor": {"type":"string", "minLength":1},
    "library": {"type":"string", "minLength":1},
    "version": {"type":"string", "minLength":1},
    "version_date": {"type":["string", "null"], "pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "directory_mtime": {"type":["string", "null"]},
    "directory_created_at": {"type":["string", "null"]},
    "root": {"type":"string", "minLength":1},
    "views": {"type":"object", "additionalProperties":{"type":"array", "items":{"type":"string", "minLength":1}, "uniqueItems":true}}
  }
}
