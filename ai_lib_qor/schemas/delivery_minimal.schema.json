{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["vendor", "library", "version", "version_date", "directory_created_at", "root", "views"],
  "properties": {
    "vendor": {"type":"string", "minLength":1},
    "library": {"type":"string", "minLength":1},
    "version": {"type":"string", "minLength":1},
    "version_date": {"type":["string", "null"], "pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "directory_created_at": {"type":["string", "null"]},
    "root": {"type":"string", "minLength":1},
    "views": {"type":"object", "additionalProperties":{"type":"array", "items":{"type":"string", "minLength":1}, "uniqueItems":true}}
  }
}
