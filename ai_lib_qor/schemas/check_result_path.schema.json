{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path-based CheckResult",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "vendor",
    "library",
    "revision",
    "baseline",
    "run_at",
    "state",
    "files",
    "checks",
    "comparisons",
    "changes",
    "summary",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": "check_result.path.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^rev_[0-9]+$"
    },
    "baseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "state": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "view",
          "path",
          "version",
          "absolute_path",
          "status",
          "facts",
          "note"
        ],
        "properties": {
          "view": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "absolute_path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PARSED",
              "NOT_CHECKED",
              "FAILED"
            ]
          },
          "facts": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "scope_file_keys",
          "result",
          "coverage",
          "facts_refs",
          "detail"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "scope_file_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          },
          "coverage": {
            "type": "string"
          },
          "facts_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "view": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "object_type": {
                  "type": "string"
                },
                "object_name": {
                  "type": "string"
                },
                "diff_type": {
                  "type": "string"
                },
                "old_value": {},
                "new_value": {},
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "baseline_version": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "content_status": {
            "enum": [
              "CURRENT_CONTENT_MATCH",
              "CURRENT_CONTENT_DIFF"
            ]
          },
          "facts_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "view",
          "path",
          "baseline_version",
          "version",
          "content_status",
          "facts_refs"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "baseline_version": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "object_type": {
            "type": "string",
            "minLength": 1
          },
          "object_name": {
            "type": "string",
            "minLength": 1
          },
          "attribute": {
            "type": "string",
            "minLength": 1
          },
          "old_value": {},
          "new_value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "facts_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "view",
          "path",
          "baseline_version",
          "version",
          "object_type",
          "object_name",
          "attribute",
          "old_value",
          "new_value",
          "unit",
          "facts_refs"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "failed_checks",
        "inconclusive_checks",
        "failed_files",
        "files_with_new_source",
        "files_with_confirmed_content_change"
      ],
      "properties": {
        "failed_checks": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive_checks": {
          "type": "integer",
          "minimum": 0
        },
        "failed_files": {
          "type": "integer",
          "minimum": 0
        },
        "files_with_new_source": {
          "type": "integer",
          "minimum": 0
        },
        "files_with_confirmed_content_change": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "string"
    },
    "partial_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "baseline_version": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "const": "PARTIAL"
          },
          "differences": {
            "type": "object"
          },
          "facts_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "view",
          "path",
          "baseline_version",
          "version",
          "coverage",
          "differences",
          "facts_refs",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "facts_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "tooling": {
      "type": "object",
      "properties": {
        "parser_signatures": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plugin_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "plugin_coverage": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "EXECUTED",
              "NOT_EXECUTED",
              "NOT_APPLICABLE"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "report_context": {
      "type": "object",
      "properties": {
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "deliveries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nl_observed_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "formal_snapshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "deliveries",
        "revisions",
        "nl_observed_cutoff"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
