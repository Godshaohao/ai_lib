                      },
                      "source_library_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "delivery_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "source_library_id",
                      "delivery_id",
                      "file_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "formal_file"
                      },
                      "formal_nl_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "formal_snapshot_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file_id": {
                        "type": "string",
                        "minLength": 1
                      }
