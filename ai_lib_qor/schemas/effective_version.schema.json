                      "delivery_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "source_library_id",
                      "delivery_id",
                      "file_id"
