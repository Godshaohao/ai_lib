            "minLength": 1
          },
          "source_ref": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "delivery_file"
                  },
                  "source_library_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "delivery_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_id": {
                    "type": "string",
                    "minLength": 1
