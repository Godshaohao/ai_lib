                "required": [
                  "kind",
                  "formal_nl_id",
                  "formal_snapshot_id",
                  "file_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "file_key",
          "source_ref"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "minLength": 1
