                    "const": "formal_file"
                  },
                  "formal_nl_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "formal_snapshot_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_id": {
                    "type": "string",
                    "minLength": 1
                  }
